{
  "name": "responsecompass",
  "version": "0.1.0",
  "private": true,
  "description": "Compass: context-aware responder recommendation agent",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env backend/src/server.mjs",
    "start": "node --env-file-if-exists=.env backend/src/server.mjs",
    "test": "node --test backend/tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "measure:amd": "node --env-file-if-exists=.env scripts/measure-amd-models.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
