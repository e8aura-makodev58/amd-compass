# Compass environment configuration. Copy to .env (git-ignored). Every value is
# read server-side only and is never sent to the browser.

# --- AMD Token Factory (the only model provider) ---------------------------
# OpenAI-compatible endpoint. See Compass_AMD_Token_Factory_Integration_Guide.md.
AMD_TOKEN_FACTORY_BASE_URL=https://developer.amd.com.cn/radeon/api/v1

# Team-shared key (prefixed rc-). Set the key directly, or point to a file that
# contains only the key. The direct value wins if both are set. Never commit the
# key. Inside Docker, a host file path is not visible: set the key directly, or
# save it from the Settings tab instead.
AMD_TOKEN_FACTORY_API_KEY=
AMD_TOKEN_FACTORY_API_KEY_FILE=

# Seed model and reasoning level for a fresh install; the Settings tab can
# change both later (a saved selection takes precedence on later boots).
# MiMo-V2.6-Flash with reasoning "none" is the measured default. "default"
# leaves reasoning unset, which turns MiMo's thinking on.
AMD_TOKEN_FACTORY_MODEL=MiMo-V2.6-Flash
AMD_TOKEN_FACTORY_REASONING_EFFORT=none

# Output-token cap per call (reasoning tokens count against it). A reply that
# hits the cap is treated as a failure and falls back to the deterministic path.
AMD_TOKEN_FACTORY_MAX_OUTPUT_TOKENS=4096

# --- Inference modes ------------------------------------------------------
# live | fixture | force-failure, set independently for each model role.
COMPASS_EVENT_PLANNER_MODE=live
COMPASS_LIVE_COMPASS_MODE=live

# Per-role request timeouts (milliseconds). Optional; defaults are 30000 for the
# event planner and 60000 for the Compass agent (an AMD ranking takes about
# 20-40s). A call that exceeds the limit falls back to the deterministic path.
COMPASS_EVENT_PLANNER_TIMEOUT_MS=30000
COMPASS_AGENT_TIMEOUT_MS=60000

# Keep the deterministic local fallback available when inference is disabled or
# unavailable.
COMPASS_DEMO_INFERENCE_MODE=fixture
